# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，永远不要提交它。

# ---- 必填 ----
# DeepSeek API key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# ---- 选填：不填就用 config.py 里的默认值 ----
# DeepSeek 的 OpenAI 兼容端点，一般不用改
# MINI_AGENT_BASE_URL=https://api.deepseek.com
# 模型：deepseek-v4-flash（默认，速度快/成本低）或 deepseek-v4-pro（能力更强）
# MINI_AGENT_MODEL=deepseek-v4-flash
# IterationBudget 上限，防止 agent loop 失控
# MINI_AGENT_MAX_TURNS=25
# 运行时状态根目录（state.db + logs）。默认是项目根下的 .mini_agent/，
# 已被 .gitignore 忽略。设成 ~/.mini_agent 可切回「全局共享一份状态」的老行为。
# MINI_AGENT_HOME=

# ---- 选填：日志（见 mini_agent/log.py）----
# DEBUG / INFO / WARNING / ERROR，默认 INFO
# MINI_AGENT_LOG_LEVEL=INFO
# 日志目录，默认 <MINI_AGENT_HOME>/logs
# MINI_AGENT_LOG_DIR=
# 是否打到控制台，默认 1；跑测试时设 0 更清爽
# MINI_AGENT_LOG_CONSOLE=1

# ---- 选填：文件工具沙箱（见 mini_agent/tools/builtin/file_tools.py）----
# read_file / write_file / list_dir 能碰到的**唯一**目录。默认
# <MINI_AGENT_HOME>/workspace —— 刻意不是当前目录：那样 .env 就落在沙箱里，
# 模型一句 read_file('.env') 就能把上面那个 key 读出来并回显给用户。
# 改它之前先想清楚新目录里有没有不该给模型看的东西。
# MINI_AGENT_WORKSPACE=

# ---- 选填：gRPC surface（见 mini_agent/grpcserver/server.py）----
# 监听端口，要和 Go 那侧的 AGENT_ADDR 对上
# MINI_AGENT_GRPC_PORT=50051
# 并发上限（一个任务占两个线程）
# MINI_AGENT_GRPC_MAX_WORKERS=16
# 监听地址。默认 127.0.0.1（只有本机能连）。这个端口能跑任意任务、读写工作区、
# 消耗 LLM 额度，往外绑之前必须先配好下面的 token —— 没配的话服务会拒绝启动。
# MINI_AGENT_GRPC_HOST=127.0.0.1
# 服务间共享密钥，至少 32 字节，且只能是**可见 ASCII**（不含空格）。
# Go 那侧填同一个值到 AGENT_GRPC_TOKEN。绑回环时可以不填；
# 一旦 MINI_AGENT_GRPC_HOST 不是回环地址就是必填。
#
# 为什么限 ASCII：它要放进 gRPC metadata，非 ASCII 会让每一次调用都在传输层
# 被拒（Illegal header value），而启动时看不出任何异常。填错了服务会拒绝启动。
# 生成一个：openssl rand -base64 48
# MINI_AGENT_GRPC_TOKEN=
